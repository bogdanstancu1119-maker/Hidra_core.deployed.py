name: Hydra Singularity Heartbeat
on:
  schedule: [{cron: '*/30 * * * *'}]
  workflow_dispatch:
jobs:
  heartbeat:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v3
      - uses: actions/setup-python@v4
        with: {python-version: '3.11'}
      - env:
          HYDRA_MASTER_EMAIL: ${{ secrets.HYDRA_MASTER_EMAIL }}
          HUGGINGFACE_TOKEN: ${{ secrets.HUGGINGFACE_TOKEN }}
          VERCEL_TOKEN: ${{ secrets.VERCEL_TOKEN }}
          BASE44_TOKEN: ${{ secrets.BASE44_TOKEN }}
        run: |
          python -m core.hydra_singularity
          git config user.name "Hydra"
          git config user.email "${{ secrets.HYDRA_MASTER_EMAIL }}"
          git add roiul/
          git commit -m "singularity - S_{n+1}=S_n*2" || echo "viu"
          git push